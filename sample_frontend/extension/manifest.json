{
  "manifest_version": 3,
  "name": "Jawb Tracker",
  "version": "1.0.0",
  "description": "Copy a job posting, open the popup, parse it, and score it against your main resume — without leaving the page.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Jawb Tracker",
    "default_icon": "icons/icon.svg"
  },
  "icons": {
    "128": "icons/icon.svg"
  },
  "permissions": ["activeTab", "storage", "clipboardRead"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ]
}
